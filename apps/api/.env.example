# Server
PORT=3030
HOST=127.0.0.1
NODE_ENV=development

# Database (MVP 用 SQLite,Phase 4 切 Postgres)
DATABASE_URL=file:./storage/dev.sqlite

# AI(对应 §5.7 AI Key 配置)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
DEFAULT_MODEL=gpt-4o

# 子仓库绑定
SKILL_BUNDLE_REPO_PATH=../dotnet-security-audit-skill

# 安全
APP_MASTER_KEY=change-me-in-production
SESSION_SECRET=change-me-in-production

# 部署
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5180

# §11 Q6 —— 扫描并发上限(BullMQ + Redis,Phase 2 升级 2026-06-28)
# 范围 1-10,默认 2;超过范围启动期会抛错
SCAN_MAX_CONCURRENT=2

# §11 Q6 —— BullMQ 后端 Redis(BullMQ 4/5 硬依赖,无 in-memory transport)
# 本机推荐:Docker Desktop 跑 `docker run -d --name redis -p 6379:6379 redis:7-alpine`
# 或 Memurai / WSL apt 装 redis-server
REDIS_HOST=127.0.0.1
REDIS_PORT=6379