# Server
PORT=3030
HOST=127.0.0.1
NODE_ENV=development

# Database (MVP 用 SQLite,Phase 4 切 Postgres)
DATABASE_URL=file:./storage/dev.sqlite

# AI(对应 §5.7 AI Key 配置)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
DEFAULT_MODEL=gpt-4o

# 子仓库绑定
SKILL_BUNDLE_REPO_PATH=../dotnet-security-audit-skill

# 安全
APP_MASTER_KEY=change-me-in-production
SESSION_SECRET=change-me-in-production

# 部署
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5180