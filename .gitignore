# 独立嵌入的 git 仓库(由其自身流程演进,平台不跟踪)
dotnet-security-audit-skill/

# 平台代码(.gitignore 标准起步,后续按需扩展)
node_modules/
dist/
build/
.turbo/
.cache/
.next/

# 环境与本地配置
.env
.env.local
.env.*.local
*.log
npm-debug.log*
pnpm-debug.log*
.DS_Store
Thumbs.db

# 编辑器
.vscode/
.idea/
*.swp
*.swo

# Claude 本地配置
CLAUDE.local.md
.claude/settings.local.json

# pnpm
.pnpm-store/

# SQLite 数据库(平台运行时生成)
*.sqlite
*.sqlite-journal
*.db
*.db-journal

# 扫描产物(运行时生成)
output/
storage/

# 启动脚本日志(start.bat 写到 logs/*.log)
logs/

# TypeScript 增量编译缓存(tsc --incremental / 项目引用)
*.tsbuildinfo
*.zip
